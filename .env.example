# Meta WhatsApp Cloud API (server-side only; do not expose these values with NEXT_PUBLIC_)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
DOCTOR_WHATSAPP_TO=
# Template sent to the doctor. Body variables: {{1}} patient name, {{2}} date, {{3}} time, {{4}} patient phone, {{5}} booking ID
META_WHATSAPP_TEMPLATE_NAME=appointment_booked
# Template sent to the patient. Body variables: {{1}} patient name, {{2}} doctor name, {{3}} date, {{4}} time, {{5}} booking ID
META_WHATSAPP_PATIENT_TEMPLATE_NAME=appointment_confirmed
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Country code added to 10-digit patient numbers entered without "+" (e.g. 91 for India)
WHATSAPP_DEFAULT_COUNTRY_CODE=91
